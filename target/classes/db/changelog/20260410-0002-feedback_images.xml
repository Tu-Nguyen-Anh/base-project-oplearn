<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create-feedback-images-table" author="tuna">
        <createTable tableName="feedback_images">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="feedback_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="image_url" type="TEXT"><constraints nullable="false"/></column>
            <column name="storage_key" type="TEXT"/>
            <column name="original_name" type="VARCHAR(500)"/>
            <column name="uploaded_at" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="feedback_images" baseColumnNames="feedback_id"
            referencedTableName="feedbacks" referencedColumnNames="id"
            constraintName="fk_feedback_images_feedback_id"/>
        <createIndex tableName="feedback_images" indexName="idx_feedback_images_feedback_id">
            <column name="feedback_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

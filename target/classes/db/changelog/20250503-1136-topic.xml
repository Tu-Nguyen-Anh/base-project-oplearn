<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create-topics-table" author="tuna">
        <createTable tableName="topics">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(1024)"/>
            <column name="url" type="VARCHAR(1024)"/>
            <column name="rss_url" type="VARCHAR(1024)"/>
            <column name="description" type="TEXT"/>
            <column name="source_id" type="BIGINT"/>
            <column name="deleted" type="BOOLEAN"/>
            <column name="last_updated_by" type="varchar(255)"/>
            <column name="last_updated_at" type="bigint"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="bigint"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="topics" baseColumnNames="source_id"
                referencedTableName="sources" referencedColumnNames="id"
                constraintName="fk_topics_source_id_source_id"/>
    </changeSet>
</databaseChangeLog>

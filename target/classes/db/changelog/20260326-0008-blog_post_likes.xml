<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="create-blog-post-likes-table" author="tuna">
        <createTable tableName="blog_post_likes">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="post_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="last_updated_by" type="VARCHAR(255)"/>
            <column name="last_updated_at" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="BIGINT"/>
        </createTable>
        <addUniqueConstraint tableName="blog_post_likes" columnNames="post_id, user_id"
            constraintName="uq_blog_post_likes_post_user"/>
        <addForeignKeyConstraint baseTableName="blog_post_likes" baseColumnNames="post_id"
            referencedTableName="blog_posts" referencedColumnNames="id"
            constraintName="fk_blog_post_likes_post_id"/>
        <addForeignKeyConstraint baseTableName="blog_post_likes" baseColumnNames="user_id"
            referencedTableName="users" referencedColumnNames="id"
            constraintName="fk_blog_post_likes_user_id"/>
    </changeSet>
</databaseChangeLog>

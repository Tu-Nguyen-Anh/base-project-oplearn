<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create-comment-mentions-table" author="tuna">
        <createTable tableName="comment_mentions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="comment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="mentioned_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated_by" type="varchar(255)"/>
            <column name="last_updated_at" type="bigint"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_at" type="bigint"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="comment_mentions" baseColumnNames="comment_id"
                referencedTableName="article_comments" referencedColumnNames="id"
                constraintName="fk_comment_mentions_comment_id"/>

        <addForeignKeyConstraint
                baseTableName="comment_mentions" baseColumnNames="mentioned_user_id"
                referencedTableName="users" referencedColumnNames="id"
                constraintName="fk_comment_mentions_mentioned_user_id"/>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="init-data" author="tuna" runOnChange="true">
        <loadData
                file="db/data/users.csv"
                relativeToChangelogFile="false"
                separator=","
                tableName="users"
                encoding="UTF-8">
        </loadData>
    </changeSet>

    <changeSet id="init-sources" author="tuna" runOnChange="true">
        <loadData
                file="db/data/source.csv"
                relativeToChangelogFile="false"
                separator=","
                tableName="sources"
                encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="url" type="STRING"/>
            <column name="avatar" type="STRING"/>
            <column name="type" type="NUMERIC"/>
            <column name="description" type="STRING"/>
            <column name="deleted" type="BOOLEAN"/>
            <column name="last_updated_by" type="STRING"/>
            <column name="last_updated_at" type="NUMERIC"/>
            <column name="created_by" type="STRING"/>
            <column name="created_at" type="NUMERIC"/>
        </loadData>
    </changeSet>

    <changeSet id="init-topics" author="tuna" runOnChange="true">
        <loadData
                file="db/data/topic.csv"
                relativeToChangelogFile="false"
                separator=","
                tableName="topics"
                encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="url" type="STRING"/>
            <column name="rss_url" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="deleted" type="BOOLEAN"/>
            <column name="last_updated_by" type="STRING"/>
            <column name="last_updated_at" type="NUMERIC"/>
            <column name="created_by" type="STRING"/>
            <column name="created_at" type="NUMERIC"/>
            <column name="source_id" type="NUMERIC"/>
        </loadData>
    </changeSet>
</databaseChangeLog>
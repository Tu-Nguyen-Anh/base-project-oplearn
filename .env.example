# ═══════════════════════════════════════════════════════════════
#  Environment Variables — base-project-oplearn
#  Copy file này thành .env và điền giá trị thực
# ═══════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────
PORT_INTERNAL=8188
PROFILE_ACTIVE=dev

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_URL=jdbc:postgresql://localhost:5432/news_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=localhost:3000,localhost:8888

# ─── RustFS (S3-compatible Object Storage) ─────────────────────
# Endpoint backend dùng để upload/delete file
# Nếu đã public domain → dùng domain, nếu dùng nội bộ → dùng IP:port
RUSTFS_ENDPOINT=https://rustfs.olhub.org

# Access key và secret key của RustFS
# Xem tại RustFS console (port 9009)
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# Tên bucket (phải tạo trước trong RustFS console)
RUSTFS_BUCKET=news

# Region (để mặc định us-east-1 với RustFS)
RUSTFS_REGION=us-east-1

# URL public để browser/app truy cập file
# URL ảnh sẽ có dạng: {RUSTFS_PUBLIC_URL}/{RUSTFS_BUCKET}/feedbacks/uuid.jpg
# Ví dụ: https://rustfs.olhub.org/news/feedbacks/uuid.jpg
RUSTFS_PUBLIC_URL=https://rustfs.olhub.org
